{
  "rules": {
    ".read": false,
    ".write": false,
    "teams": {
      "$teamId": {
        ".read": "auth != null && (auth.token.vccId == $teamId || auth.token.teamId == $teamId || auth.token.role == 'admin')",
        ".write": false
      }
    },
    "admins": {
      ".read": "auth != null && auth.token.role == 'admin'",
      ".write": "auth != null && auth.token.role == 'admin'",
      ".indexOn": ["username"]
    },
    "prompts": {
      "$promptId": {
        ".read": "auth != null && (data.child('vccId').val() == auth.token.vccId || data.child('vccId').val() == auth.token.teamId || auth.token.role == 'admin')",
        ".write": "auth != null && auth.token.role == 'admin'"
      }
    },
    "promptEvaluations": {
      "$teamId": {
        ".read": "auth != null && (auth.token.vccId == $teamId || auth.token.teamId == $teamId || auth.token.role == 'admin')",
        ".write": "auth != null && auth.token.role == 'admin'"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.role == 'admin'"
    }
  }
}