# =================================================================
# Vibeathon Backend - Environment Variables Example
# Duplicate this file as .env for local development or configure
# these keys in your deployment platform dashboard (e.g. Render).
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# =================================================================

# Server Port (Render sets this automatically)
PORT=5000

# Gemini API Configuration for AI Prompt Evaluation
# Single key:
GEMINI_API_KEY=your_gemini_api_key_here
# Or multiple keys for automatic rotation and rate-limit failover (comma-separated):
# GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-3.6-flash

# Firebase Web API Key (Used by Auth REST API endpoints)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://your-firebase-project-default-rtdb.firebaseio.com

# Firebase Admin Service Account Credentials
# Option A (Recommended for Render): Single-line JSON string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"your-private-key-string","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}

# Option B (Render Secret File): Absolute path to mounted secret file
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json

# Optional: Frontend Origin URL for CORS (e.g., https://your-app.vercel.app)
# FRONTEND_URL=https://your-vibeathon.vercel.app

# Optional: Demo Admin credentials (if enabled for initial staging/testing)
# DEMO_ADMIN_USER=admin
# DEMO_ADMIN_PASSWORD=your_secure_admin_password_here
